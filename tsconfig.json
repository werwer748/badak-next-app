{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    // TypeScript의 엄격 모드, 실무에서 버그를 사전에 막아주는 핵심 옵션
    "strict": true,
    // TypeScript를 JS로 컴파일하면 보통 .js 파일이 생성
    // 근데 Next.js는 컴파일을 자기가 직접한다. 그래서 TypeScript한테 "타입 검사만 하고 파일은 뽑지 마"라고 하는 것.
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    // 모듈을 어떻게 찾을지 결정하는 옵션
    // bundler로 설정하면 Turbopack/Webpack 방식으로 모듈을 찾아요. Next.js 16에서 권장하는 설정
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // JSX를 JS로 변환하지 말고 그대로 놔두라는 뜻. Next.js가 알아서 변환
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // 실무에서 엄청 편한 설정이에요.
    // 나중에 import { Button } from "@/_components/Button" 이렇게 쓸 수 있게 해주는 설정입니다.
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
